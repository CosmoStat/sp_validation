    "})\n",
    "from shear_psf_leakage.rho_tau_stat import RhoStat, TauStat, PSFErrorFit\n",
    "\n",
    "import treecorr\n",
    "\n",
    "from getdist import plots, MCSamples\n",
    "\n",
    "%matplotlib inline"
   ]
  },
  {
