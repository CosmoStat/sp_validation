   "outputs": [],
   "source": [
    "path_gal_cat = {\n",
    "    'SP_v1.4-P1+3': '/sps/euclid/Users/sguerrin/data/CFIS/unions_shapepipe_2022_P1+3_v1.4.1.fits'\n",
    "}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [],
   "source": [
    "version = 'SP_v1.3_LFmask_8k_wcs'\n",
    "base_dir = '/sps/euclid/Users/sguerrin/results/cov_mat/'+version\n",
    "cov_tau_sim = np.load(base_dir+'/cov_tau_'+version+'_sim.npy')\n",
    "cov_tau_jk = np.load(base_dir+'/cov_tau_'+version+'.npy')\n",
    "cov_tau_th = np.load(base_dir+'/cov_tau_'+version+'_th.npy')\n",
    "#cov_tau_th_test = np.load(base_dir+'/cov_tau_SP_v1.4-P3_th_test.npy')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
