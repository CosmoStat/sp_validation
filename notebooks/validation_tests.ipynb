   "source": [
    "# Kappa map\n",
    "kappaE_cal, kappaB_cal = ks93(e1map,-e2map) # Global calibration\n",
    "kappaE_8px, kappaB_8px = ks93(e_8px[0], -e_8px[1]) # ei/Rii\n",
    "kappaE_64px, kappaB_64px = ks93(e_64px[0], -e_64px[1])\n",
    "kappaE_1px, kappaB_1px = ks93(e_1px[0], -e_1px[1])\n",
    "\n",
    "kappaE_dm, kappaB_dm = ks93(e_8px_dm[0], -e_8px_dm[1]) # ei/(Rii+dm)\n",
    "kappaE_64px_dm, kappaB_64px_dm = ks93(e_64px_dm[0], -e_64px_dm[1]) \n",
    "kappaE_1px_dm, kappaB_1px_dm = ks93(e_1px_dm[0], -e_1px_dm[1]) \n",
    "\n",
    "kappaE_R_8px, kappaB_R_8px = ks93(e_cal_8px[0], -e_cal_8px[1]) # R⁻1 * e\n",
    "kappaE_R_64px, kappaB_R_8px = ks93(e_cal_64px[0], -e_cal_64px[1]) \n",
    "kappaE_R_1px, kappaB_R_1px = ks93(e_cal_1px[0], -e_cal_1px[1]) \n",
    "\n",
    "kappaE_R_8px_dm, kappaB_R_8px_dm = ks93(e_cal_8px_dm[0], -e_cal_8px_dm[1]) # (R⁻1+ I.dm) * e\n",
    "kappaE_R_64px_dm, kappaB_R_8px_dm = ks93(e_cal_64px_dm[0], -e_cal_64px_dm[1]) \n",
    "kappaE_R_1px_dm, kappaB_R_1px_dm = ks93(e_cal_1px_dm[0], -e_cal_1px_dm[1]) "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "#galaxy number density in gal/arcmin^2\n",
    "n_gal=7 # gal/arcmin^2 in the survey\n",
    "\n",
    "#pixel size in arcmin\n",
    "pix_arcmin=0.8\n",
    "\n",
