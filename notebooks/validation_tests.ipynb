   "outputs": [],
   "source": [
    "c1_galsim, err_c1_galsim = jackknif_weighted_average(g_corr_galsim[0], np.ones_like(w_galsim), remove_size=0.05, n_realization=500)\n",
    "print('Additive bias c1 : {:.3e} +/- {:.3e}'.format(c1_galsim, err_c1_galsim))\n",
    "stat_file.write('Additive bias c1 : {:.3e} +/- {:.3e}\\n'.format(c1_galsim, err_c1_galsim))"
   ]
