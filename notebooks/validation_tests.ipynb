   "source": [
    "# max size of x, y : will be use to set extent on bin2d function for R selection\n",
    "xforR, yforR = radec2xy(np.mean(dd['XWIN_WORLD'][m_gal_ngmix]), np.mean(dd['YWIN_WORLD'][m_gal_ngmix]), dd['XWIN_WORLD'][m_gal_ngmix], dd['XWIN_WORLD'][m_gal_ngmix])\n",
