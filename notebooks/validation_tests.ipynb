   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## $\\xi^{sys}$\n",
    "\n",
    "Use PSF ellipticity at star positions."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Equation alpha leakage :\n",
    "$\n",
    "\\xi^{sys} = \\frac{\\xi_{\\pm}^{gp^{2}}}{\\xi_{\\pm}^{pp}}\n",
    "$    \n",
    "With $g$: galaxy and $p$: PSF."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "C_sys_p_ngmix = r_corr_gp_ngmix.xip**2/r_corr_pp_ngmix.xip\n",
    "C_sys_m_ngmix = r_corr_gp_ngmix.xim**2/r_corr_pp_ngmix.xim\n",
    "#C_sys_var = np.sqrt(r_corr_gp.varxi**2./r_corr_pp.varxi)\n",
    "C_sys_std_p_ngmix = np.abs(C_sys_p_ngmix) * np.sqrt((((2*r_corr_gp_ngmix.xip**2.*np.sqrt(r_corr_gp_ngmix.varxip))/r_corr_gp_ngmix.xip)/r_corr_gp_ngmix.xip**2.)**2. + (np.sqrt(r_corr_pp_ngmix.varxip)/r_corr_pp_ngmix.xip)**2.)\n",
    "C_sys_std_m_ngmix = np.abs(C_sys_m_ngmix) * np.sqrt((((2*r_corr_gp_ngmix.xim**2.*np.sqrt(r_corr_gp_ngmix.varxim))/r_corr_gp_ngmix.xim)/r_corr_gp_ngmix.xim**2.)**2. + (np.sqrt(r_corr_pp_ngmix.varxim)/r_corr_pp_ngmix.xim)**2.)"
   ]
