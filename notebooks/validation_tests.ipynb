   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "c2_ngmix, err_c2_ngmix = jackknif_weighted_average(g_corr_ngmix[1], w_ngmix, remove_size=0.05, n_realization=500)\n",
