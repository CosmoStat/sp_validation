   "metadata": {},
   "outputs": [],
   "source": [
    "cluster_cat_name = 'HFI_PCCS_SZ-union_R2.08.fits.gz'\n",
    "source = 'vos:cfis/cosmostat/cosmology/external/Planck/{}'.format(cluster_cat_name)\n",
    "download(source, cluster_cat_name, verbose=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "cluster_cat = fits.getdata(cluster_cat_name)\n",
    "m_good_cluster = (cluster_cat['MSZ'] != 0) & (cluster_cat['COSMO'] == True)\n",
