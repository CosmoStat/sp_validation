    "ycut_m1 = yforR[gal_metacal_ngmix.mask_dict['m1']]\n",
    "\n",
    "xcut_m2 = xforR[gal_metacal_ngmix.mask_dict['m2']]\n",
    "ycut_m2 = yforR[gal_metacal_ngmix.mask_dict['m2']]\n",
    "\n",
    "# Verification of the shape\n",
    "np.shape(xcut_p1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def bin_Rselec(npix):\n",
    "    # Binning of R selection on npix\n",
    "    \n",
    "    Rselec_11a = bin2d(xcut_p1,ycut_p1,npix=npix,v=(gal_metacal_ngmix.ns['g1'][gal_metacal_ngmix.mask_dict['p1']]),extent=(minx,maxx,miny,maxy))\n",
    "    Rselec_11b = bin2d(xcut_m1,ycut_m1,npix=npix,v=(gal_metacal_ngmix.ns['g1'][gal_metacal_ngmix.mask_dict['m1']]),extent=(minx,maxx,miny,maxy))\n",
    "    Rselec_11 = (Rselec_11a-Rselec_11b)/0.02\n",
    "\n",
    "    Rselec_22a = bin2d(xcut_p2,ycut_p2,npix=npix,v=(gal_metacal_ngmix.ns['g2'][gal_metacal_ngmix.mask_dict['p2']]),extent=(minx,maxx,miny,maxy))\n",
    "    Rselec_22b = bin2d(xcut_m2,ycut_m2,npix=npix,v=(gal_metacal_ngmix.ns['g2'][gal_metacal_ngmix.mask_dict['m2']]),extent=(minx,maxx,miny,maxy))\n",
    "    Rselec_22 = (Rselec_22a-Rselec_22b)/0.02\n",
    "\n",
    "    Rselec_12a = bin2d(xcut_p2,ycut_p2,npix=npix,v=(gal_metacal_ngmix.ns['g1'][gal_metacal_ngmix.mask_dict['p2']]),extent=(minx,maxx,miny,maxy))\n",
    "    Rselec_12b = bin2d(xcut_m2,ycut_m2,npix=npix,v=(gal_metacal_ngmix.ns['g1'][gal_metacal_ngmix.mask_dict['m2']]),extent=(minx,maxx,miny,maxy))\n",
    "    Rselec_12 = (Rselec_12a-Rselec_12b)/0.02\n",
    "\n",
    "    Rselec_21a = bin2d(xcut_p1,ycut_p1,npix=npix,v=(gal_metacal_ngmix.ns['g2'][gal_metacal_ngmix.mask_dict['p1']]),extent=(minx,maxx,miny,maxy))\n",
    "    Rselec_21b = bin2d(xcut_m1,ycut_m1,npix=npix,v=(gal_metacal_ngmix.ns['g2'][gal_metacal_ngmix.mask_dict['m1']]),extent=(minx,maxx,miny,maxy))\n",
    "    Rselec_21 = (Rselec_21a-Rselec_21b)/0.02\n",
    "\n",
    "    Rselec = np.array([[Rselec_11,Rselec_12],[Rselec_21,Rselec_22]])\n",
    "    return Rselec"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# R selection with different binning\n",
    "Rselec8 = bin_Rselec(8)\n",
    "Rselec1 = bin_Rselec(1)\n",
    "Rselec64 = bin_Rselec(64)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def bin_Rtot(Rshear,Rselec,npix):\n",
    "    # R tot = R shear + R selection\n",
    "    \n",
    "    Rtot = np.zeros((2,2,npix,npix))\n",
    "    for i in range(npix):\n",
    "        for j in range(npix):\n",
    "            Rtot[:,:,i,j] = Rshear[:,:,i,j] + Rselec[:,:,i,j]\n",
    "    return Rtot"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# R tot with different binning\n",
    "Rtot8 = bin_Rtot(Rmap8,Rselec8,8)\n",
    "Rtot1 = bin_Rtot(Rmap1,Rselec1,1)\n",
    "Rtot64 = bin_Rtot(Rmask64,Rselec64,64)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def Rtot_extent_inv(npix,R):\n",
    "    # Function for create the inverse of R and extend it to 512 px\n",
    "    \n",
    "    # Inverse\n",
    "    R_inv = np.zeros((2,2,npix,npix))\n",
    "    for i in range(npix):\n",
    "        for j in range(npix):\n",
    "            R_inv[:,:,i,j] = np.linalg.inv(R[:,:,i,j])\n",
    "            \n",
    "    # Extend from npix x npix to 512x512       \n",
    "    mult = int(512/npix)\n",
    "    R_inv512 = np.zeros((2,2,512,512))\n",
    "    for i in range(npix):\n",
    "        for j in range(npix):\n",
    "            R_temp = np.zeros((2,2,mult,mult))\n",
    "            for k in range(mult):\n",
    "                for l in range(mult):\n",
    "                    R_temp[:,:,k,l] = R_inv[:,:,i,j]\n",
    "                    R_inv512[:,:,i*mult:(i+1)*mult,j*mult:(j+1)*mult] = R_temp\n",
    "                    \n",
    "    return R_inv512"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def Rtot_extent(npix,R):       \n",
    "    # Extend from npix x npix to 512x512       \n",
    "    mult = int(512/npix)\n",
    "    R_inv512 = np.zeros((2,2,512,512))\n",
    "    for i in range(npix):\n",
    "        for j in range(npix):\n",
    "            R_temp = np.zeros((2,2,mult,mult))\n",
    "            for k in range(mult):\n",
    "                for l in range(mult):\n",
    "                    R_temp[:,:,k,l] = R[:,:,i,j]\n",
    "                    R_inv512[:,:,i*mult:(i+1)*mult,j*mult:(j+1)*mult] = R_temp\n",
    "                    \n",
    "    return R_inv512"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# R extend and inverse\n",
    "R_8px_inv = Rtot_extent_inv(8,Rtot8)\n",
    "R_1px_inv = Rtot_extent_inv(1,Rtot1)\n",
    "R_64px_inv = Rtot_extent_inv(64,Rtot64)\n",
    "\n",
    "# R extend\n",
    "R_8px = Rtot_extent(8,Rtot8)\n",
    "R_1px = Rtot_extent(1,Rtot1)\n",
    "R_64px = Rtot_extent(64,Rtot64)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Compute e"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def compute_e(R,Rinv,dm,Rpx,npix):\n",
    "    # Different way to compute e, with and without dm\n",
    "    \n",
    "    # ei/Rii\n",
    "    e1 = e1map_uncal/R[0,0,:,:]\n",
    "    e2 = e2map_uncal/R[1,1,:,:]\n",
    "    e = np.array([e1,e2])\n",
    "\n",
    "    # ei/(Rii + dm)\n",
    "    e1_dm = e1map_uncal/(R[0,0,:,:]+dm)\n",
    "    e2_dm = e2map_uncal/(R[1,1,:,:]+dm)\n",
    "    e_dm = np.array([e1_dm,e2_dm])\n",
    "    \n",
    "    # R⁻1 * e\n",
    "    e_cal = np.zeros((2,512,512))\n",
    "    for i in range(512):\n",
    "        for j in range(512):\n",
    "            e_cal[:,i,j] = Rinv[:,:,i,j].dot(e_uncal[:,i,j])\n",
    "            \n",
    "    # (R-1 + I.dm) * e            \n",
    "    # Inverse, Rpx is R tot on npix\n",
    "    R_dm_px = Rpx + (np.ones((npix,npix))*dm)\n",
    "    R_inv = np.zeros((2,2,npix,npix))\n",
    "    for i in range(npix):\n",
    "        for j in range(npix):\n",
    "            R_inv[:,:,i,j] = np.linalg.inv(R_dm_px[:,:,i,j])         \n",
    "    # Extend from npix x npix to 512x512       \n",
    "    mult = int(512/npix)\n",
    "    R_inv512 = np.zeros((2,2,512,512))\n",
    "    for i in range(npix):\n",
    "        for j in range(npix):\n",
    "            R_temp = np.zeros((2,2,mult,mult))\n",
    "            for k in range(mult):\n",
    "                for l in range(mult):\n",
    "                    R_temp[:,:,k,l] = R_inv[:,:,i,j]\n",
    "                    R_inv512[:,:,i*mult:(i+1)*mult,j*mult:(j+1)*mult] = R_temp\n",
    "    # compute e\n",
    "    e_cal_dm = np.zeros((2,512,512))\n",
    "    for i in range(512):\n",
    "        for j in range(512):\n",
    "            e_cal_dm[:,i,j] = R_inv512[:,:,i,j].dot(e_uncal[:,i,j])\n",
    "                    \n",
    "            \n",
    "    return e, e_dm, e_cal, e_cal_dm"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "e_8px, e_8px_dm, e_cal_8px, e_cal_8px_dm = compute_e(R_8px,R_8px_inv,0.013,Rtot8,8)\n",
    "e_64px, e_64px_dm, e_cal_64px, e_cal_64px_dm = compute_e(R_64px,R_64px_inv,0.013,Rtot64,64)\n",
    "e_1px, e_1px_dm, e_cal_1px, e_cal_1px_dm = compute_e(R_1px,R_1px_inv,0.013,Rtot1,1)"
   ]
  },
  {
   "cell_type": "code",
