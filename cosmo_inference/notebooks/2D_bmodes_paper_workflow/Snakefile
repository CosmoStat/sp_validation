    PLANCK18 = json.load(_f)

# Wildcard constraints — centralized here, not in individual rule files
# Patterns must match all expected values; overly restrictive patterns cause silent failures
wildcard_constraints:
    version=r"SP_v[\d.]+(_w_iv)?(_ecut\d+)?(_leak_corr)?",
    blind=r"[ABC]",
    nbins=r"\d+",
    min_sep=r"[0-9.]+",
    max_sep=r"[0-9.]+",
    gaussian=r"(g|ng)",
    block_pm=r"(\+\+|--|\+-)",
    block_i=r"[123]",
    mask_suffix=r"(_masked)?",
    mock_id=r"\d{5}",
    nside=r"\d+",

# Common paths
COSMO_VAL = Path("/n17data/cdaley/unions/pure_eb/code/sp_validation/notebooks/cosmo_val/output")
COSMO_INFERENCE = Path("/n17data/cdaley/unions/pure_eb/code/sp_validation/cosmo_inference")

