"""Standalone entry point for the calibrate stage (workflow/rules/calibrate.smk).

Builds the calibrated shear sample without the cosmology-validation config the
top-level ``workflow/Snakefile`` requires::

    snakemake --profile workflow/profiles/default -s workflow/calibrate/Snakefile -j 32

``configfile:`` below names the v2 recipe; ``--config calibrate='{...}'`` or a
``--configfile`` of your own overrides it (targets go before ``--configfile``).
The same rules are included in the main workflow under
``if "calibrate" in config``. See scripts/calibration/README.md.
"""

import os
import sys

sys.path.insert(0, os.path.realpath(os.path.join(str(workflow.basedir), "..")))
import common



configfile: os.path.join(str(workflow.basedir), "config.yaml")


# The checkout's src wins over the image's copy of sp_validation.
common.inject_checkout_pythonpath(config)


container: common.resolve_container(config.get("container"))


include: "../rules/calibrate.smk"


rule all:
    input:
        rules.calibrated_sample.output,
        rules.compare_calibrated_sample.output if config["calibrate"].get("reference") else [],
