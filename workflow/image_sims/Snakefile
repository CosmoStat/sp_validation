"""Standalone entry point for the image-simulation m-bias workflow.

Run the sp_validation-side chain (merge -> extract -> calibrate -> m-bias),
optionally including the ShapePipe pipeline stage, without pulling in the
cosmology-validation config the top-level ``workflow/Snakefile`` requires.

Launch it with ``workflow/bin/spv run -c my_run.yaml`` (``-n`` for a dry run),
which snapshots the code, sets the temporary directories and passes the profile;
see ``spv --help``. ``configfile:`` below loads the operational defaults (the
main config), so ``my_run.yaml`` need only carry the science knobs and any
override; Snakemake deep-merges the two.

Driving snakemake directly also works: put targets *before* ``--configfile``
(it takes one-or-more paths, so a target after it is swallowed as a config
path), and on candide set TMPDIR/APPTAINER_TMPDIR yourself.

The same rules are also included in the main workflow under
``if "image_sims" in config``.
"""

import os
import sys

# Shared helpers from the generic workflow one directory up -- resolve_container
# in particular, so `sif: null` here falls back to the same image every other
# entry point runs. Snakemake's `include:` shares Python globals, so
# image_sims.smk sees this import.
sys.path.insert(0, os.path.realpath(os.path.join(str(workflow.basedir), "..")))
import common


# Next to this file, not relative to the working directory: spv runs snakemake
# from the campaign's state directory, out of a code snapshot.
configfile: os.path.join(str(workflow.basedir), "config.yaml")


include: "../rules/image_sims.smk"


rule all:
    input:
        f"{GRIDS_BASE}/results/m_bias_results.yaml",
